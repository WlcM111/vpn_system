FROM golang:1.26-alpine AS builder

WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/vpn-orchestrator-service ./cmd/vpn-orchestrator-service

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -H -u 10001 appuser
WORKDIR /app
COPY --from=builder /out/vpn-orchestrator-service ./vpn-orchestrator-service
USER appuser
EXPOSE 8084
ENTRYPOINT ["./vpn-orchestrator-service"]