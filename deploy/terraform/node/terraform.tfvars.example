# Скопируй в terraform.tfvars и заполни под себя.
# terraform.tfvars НЕ коммитится — он в .gitignore.

region       = "eu-north-1"
node_name    = "se-main-1"
country_code = "SE"

# Публичная часть твоего SSH-ключа
ssh_public_key = "ssh-rsa AAAA... you@host"

# Сузь до своего адреса: ssh_allowed_cidrs = ["203.0.113.45/32"]
ssh_allowed_cidrs = ["0.0.0.0/0"]

# Адрес Kafka центра — куда нода шлёт heartbeat
kafka_brokers = "main.race-src.com:19092"

# Почта для уведомления о расходах
alarm_email                 = "you@example.com"
billing_alarm_threshold_usd = 10