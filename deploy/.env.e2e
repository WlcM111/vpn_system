# Окружение для E2E-тестов. Все значения тестовые, секретов здесь нет.

POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn_e2e
POSTGRES_DB=vpn_platform
DATABASE_URL=postgres://vpn:vpn_e2e@postgres:5432/vpn_platform?sslmode=disable

KAFKA_BROKERS=kafka:9092
PUBLIC_DOMAIN=localhost
REDIS_ADDR=redis:6379

# Grafana поднимается вместе со стеком и требует пароль администратора.
# Значение тестовое: окружение живёт только на время прогона.
GF_SECURITY_ADMIN_PASSWORD=e2e-grafana-pass

# Telegram выключен: бот поднимется в mock-режиме и не пойдёт в сеть.
TELEGRAM_BOT_TOKEN=
TG_ALLOW_MOCK_BACKEND=true

# YooKassa: адрес переопределяется в docker-compose.e2e.yml
YOOKASSA_SHOP_ID=e2e-shop
YOOKASSA_SECRET_KEY=e2e-secret
YOOKASSA_WEBHOOK_TOKEN=e2e-webhook-token
YOOKASSA_RETURN_URL=https://example.invalid/return
YOOKASSA_ENFORCE_IP_CHECK=false

ORCHESTRATOR_ADMIN_USER=admin
ORCHESTRATOR_ADMIN_PASS=e2e-admin-pass

SUBSCRIPTION_PUBLIC_BASE_URL=http://localhost:8084/sub/
SUBSCRIPTION_DEFAULT_COUNTRY=LT
SUBSCRIPTION_FEED_FORMAT=base64
TRIAL_DAYS=1

PLAN_MONTHLY_PRICE_RUB=89
PLAN_QUARTERLY_PRICE_RUB=249

# Ускоряем фоновые воркеры, чтобы тест не ждал минутами.
RECONCILE_INTERVAL=5s
BILLING_RENEWAL_TICK=5s
METRICS_COLLECT_INTERVAL=10s

# Выключаем то, что не нужно в тесте.
CDN_CONFIG_ENABLED=false
GRPC_CONFIG_ENABLED=false
HYSTERIA_CONFIG_ENABLED=false

LOG_LEVEL=info
CRYPTOBOT_API_TOKEN=
BROADCAST_TOKEN=e2e-broadcast