# House VPN — example configuration.
# Copy to .env in the repository root and fill in the values.
#
#   cp deploy/.env.example .env
#
# Variables marked REQUIRED have no default: the stack will not start without them.

# ============================================================================
# Core (REQUIRED)
# ============================================================================
POSTGRES_USER=vpn
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vpn_platform
DATABASE_URL=postgres://vpn:change_me@postgres:5432/vpn_platform?sslmode=disable

# Public domain the nodes and webhooks resolve to.
PUBLIC_DOMAIN=example.com

# Grafana admin password.
GF_SECURITY_ADMIN_PASSWORD=change_me

# ============================================================================
# Telegram
# ============================================================================
TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM=@your_support
SUPPORT_EMAIL=support@example.com

# Set to true to run the bot without contacting Telegram (local development).
TG_ALLOW_MOCK_BACKEND=false

# Optional outbound proxy for regions where the Telegram API is blocked.
TG_HTTPS_PROXY=

# ============================================================================
# Payments — YooKassa
# ============================================================================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Secret path segment of the webhook URL: /webhooks/yookassa/{token}
YOOKASSA_WEBHOOK_TOKEN=change_me
YOOKASSA_RETURN_URL=https://example.com/payment-return
# Verify that webhooks arrive from YooKassa's published IP ranges.
YOOKASSA_ENFORCE_IP_CHECK=false

# ============================================================================
# Payments — CryptoBot
#
# The service is implemented and running, but the payment option is currently
# hidden in the bot UI. Leave the token empty unless you enable it.
# ============================================================================
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_WEBHOOK_TOKEN=

# ============================================================================
# Plans (RUB)
# ============================================================================
PLAN_MONTHLY_PRICE_RUB=89
PLAN_QUARTERLY_PRICE_RUB=249
PLAN_SEMIANNUAL_PRICE_RUB=449
PLAN_ANNUAL_PRICE_RUB=799
TRIAL_DAYS=3

# ============================================================================
# Subscription feed
# ============================================================================
SUBSCRIPTION_PUBLIC_BASE_URL=https://sub.example.com/sub/
SUBSCRIPTION_DEFAULT_COUNTRY=LT
SUBSCRIPTION_FEED_FORMAT=base64
SUBSCRIPTION_RATE_LIMIT_PER_MINUTE=30
SUBSCRIPTION_RENEW_URL=https://t.me/your_bot

# ============================================================================
# Referral programme
# ============================================================================
# Paid referrals required for one free month.
REFERRAL_USERS_PER_MONTH=1
REFERRAL_DAYS_PER_MONTH=30

# ============================================================================
# Transports
#
# The base VLESS-over-WebSocket transport is always on. The rest are optional
# and configured per node through the admin API.
# ============================================================================
CDN_CONFIG_ENABLED=false
GRPC_CONFIG_ENABLED=false
HYSTERIA_CONFIG_ENABLED=false

# Split routing rules delivered with the subscription.
ROUTING_MANIFEST_PATH=/app/routing/routing-manifest.json

# ============================================================================
# Admin API (orchestrator)
# ============================================================================
ORCHESTRATOR_ADMIN_USER=admin
ORCHESTRATOR_ADMIN_PASS=change_me

# Token for the internal broadcast endpoint.
BROADCAST_TOKEN=change_me

# ============================================================================
# Client download links
# ============================================================================
APP_LINK_HAPP=https://www.happ.su/main
APP_LINK_INCY=https://incy.cc/
APP_LINK_V2RAYTUN=https://v2raytun.com/
APP_LINK_STREISAND=https://streisandapp.com/

# ============================================================================
# Tuning — defaults are sensible, override only when needed
# ============================================================================
APP_ENV=production

# Subscription expiry sweep: how often to look for expired subscriptions and
# how long to wait before revoking access.
EXPIRY_SWEEP_INTERVAL=5m
EXPIRY_SWEEP_MARGIN=15m
# Longer grace for auto-renewing subscriptions: billing owns them until then.
EXPIRY_SWEEP_AUTORENEW_MARGIN=168h

# Billing retries and grace period.
BILLING_RENEWAL_TICK=1m
BILLING_RETRY_SCHEDULE=15m,6h,24h
BILLING_GRACE_PERIOD=72h

# Node pool.
NODE_HEARTBEAT_TTL=90s
NODE_DEFAULT_MAX_USERS=1000
NODE_DEFAULT_WEIGHT=100
BALANCER_SOFT_OVERFLOW=true
RECONCILE_INTERVAL=10m
RECONCILE_BATCH_SIZE=200

# Outbox and inbox retention.
OUTBOX_BATCH_SIZE=50
OUTBOX_CLEANUP_INTERVAL=1h
OUTBOX_PUBLISHED_TTL=168h
INBOX_PROCESSED_TTL=720h

# Metrics collection.
METRICS_COLLECT_INTERVAL=15s
METRICS_HEAVY_INTERVAL=60s