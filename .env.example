# ===== Postgres =====
POSTGRES_USER=vpn
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vpn_platform
DATABASE_URL=postgres://vpn:change-me-strong-password@postgres:5432/vpn_platform?sslmode=disable

# ===== Kafka =====
KAFKA_BROKERS=kafka:9092
PUBLIC_DOMAIN=race-src.com

# ===== Redis =====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TG_SUBSCRIPTION_PUBLIC_BASE_URL=http://localhost:8084/sub/
TG_ALLOW_MOCK_BACKEND=false
TG_WEBHOOK_URL=
TG_WEBHOOK_SECRET=
TG_WEBHOOK_ADDR=:8085

# ===== YooKassa =====
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.com/payment-return
YOOKASSA_WEBHOOK_TOKEN=
YOOKASSA_API_BASE=https://api.yookassa.ru/v3
YOOKASSA_ENFORCE_IP_CHECK=false
YOOKASSA_BIND_AMOUNT_RUB=1.00

# ===== Billing service =====
PLAN_MONTHLY_PRICE_RUB=299.00
PLAN_QUARTERLY_PRICE_RUB=799.00
BILLING_HTTP_ADDR=:8082
BILLING_RENEWAL_TICK=1m
BILLING_RENEWAL_BATCH_SIZE=50
BILLING_GRACE_PERIOD=72h
BILLING_GRACE_EXPIRATION_TICK=1m
BILLING_GRACE_EXPIRATION_BATCH_SIZE=50
BILLING_REFUND_RETRY_TICK=1m
BILLING_RETRY_SCHEDULE=15m,6h,24h

# ===== User subscription service =====
USER_SUBSCRIPTION_HTTP_ADDR=:8083
SUBSCRIPTION_PUBLIC_BASE_URL=http://localhost:8084/sub/
SUBSCRIPTION_DEFAULT_COUNTRY=LT

# ===== VPN orchestrator service =====
VPN_ORCHESTRATOR_HTTP_ADDR=:8084
SUBSCRIPTION_FEED_FORMAT=base64
SUBSCRIPTION_RATE_LIMIT_PER_MINUTE=30
ORCHESTRATOR_ADMIN_USER=admin
ORCHESTRATOR_ADMIN_PASS=

# ===== VPN node agent =====
NODE_ID=lt-main-1
SERVER_KEY=lt-main-1
XRAY_APPLY_MODE=dry-run
XRAY_API_ADDR=127.0.0.1:10085
NODE_AGENT_STATE_PATH=/var/lib/vpn-node-agent/state.json
NODE_AGENT_HEARTBEAT_INTERVAL=30s
NODE_AGENT_APPLY_TIMEOUT=10s
NODE_AGENT_HTTP_ADDR=:9091

# ===== Common =====
METRICS_ADDR=:9090
LOG_LEVEL=info
PG_MAX_CONNS=20
PG_MIN_CONNS=2
PG_MAX_CONN_LIFETIME=30m
PG_MAX_CONN_IDLE_TIME=10m
PG_HEALTHCHECK_PERIOD=30s

# ===== Crypto billing service =====
# CryptoBot Pay API. Для теста используй testnet:
#   CRYPTOBOT_API_BASE=https://testnet-pay.crypt.bot/api
# Получить токен можно в @CryptoBot (или @CryptoTestnetBot) → Crypto Pay → Create App.
CRYPTOBOT_API_BASE=https://pay.crypt.bot/api
CRYPTOBOT_API_TOKEN=
# Случайный длинный секрет, который будет в URL-пути вебхука.
# Сгенерируй чем-то вроде: openssl rand -hex 32
CRYPTOBOT_WEBHOOK_TOKEN=change-me-long-random-token
CRYPTOBOT_DEFAULT_ASSET=USDT
CRYPTOBOT_INVOICE_EXPIRES_IN=1800
CRYPTOBOT_PAID_BTN_NAME=callback
# URL, который CryptoBot покажет в кнопке после успешной оплаты — обычно ссылка на твоего бота.
CRYPTOBOT_PAID_BTN_URL=

CRYPTO_BILLING_HTTP_ADDR=:8086

# Фиксированные цены в крипте (динамическая конвертация — v2).
CRYPTO_PLAN_MONTHLY_USDT=5.00
CRYPTO_PLAN_QUARTERLY_USDT=13.00
CRYPTO_PLAN_MONTHLY_TON=1.5
CRYPTO_PLAN_QUARTERLY_TON=4.0

CRYPTO_STUCK_INVOICES_TICK=1m
CRYPTO_STUCK_INVOICES_THRESHOLD=2m