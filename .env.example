# =============================================================================
#  .env — конфигурация Race-SRC VPN (центральный сервер).
#  Схема доменов:
#    race-src.com        -> литовская нода (Xray VPN)
#    main.race-src.com   -> ЭТОТ сервер: вебхуки + админка
#    sub.race-src.com    -> ЭТОТ сервер: subscription-фид
#
#  ЧТО ЗАПОЛНИТЬ ВРУЧНУЮ (помечено <<< ВПИСАТЬ >>>):
#    - сгенерировать секреты:  openssl rand -hex 24  (или 32, см. подсказки)
#    - получить токены: TELEGRAM_BOT_TOKEN, CRYPTOBOT_API_TOKEN
#    - YooKassa — позже (оставь пустым на старте, billing не упадёт)
# =============================================================================

# ===== Postgres =====
POSTGRES_USER=vpn
POSTGRES_PASSWORD=e240a925af9e36c97c3dab50869e96322c3d32797153931b
POSTGRES_DB=vpn_platform
DATABASE_URL=postgres://vpn:e240a925af9e36c97c3dab50869e96322c3d32797153931b@postgres:5432/vpn_platform?sslmode=disable

# ===== Kafka =====
# KAFKA_BROKERS — внутренний адрес для сервисов центрального сервера (не трогать).
KAFKA_BROKERS=kafka:9092
# PUBLIC_DOMAIN — внешний адрес, который Kafka анонсирует ноде.
# КРИТИЧНО: именно main.race-src.com (НЕ race-src.com — он указывает на ноду).
PUBLIC_DOMAIN=main.race-src.com

# ===== Redis =====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=8577013807:AAFRrKVr-1dcXJhqCgzmAzNzxCY99TEuSj8
TG_ALLOW_MOCK_BACKEND=false
# Вебхук бота на main:
TG_WEBHOOK_URL=https://main.race-src.com/telegram/webhook
TG_WEBHOOK_SECRET=54ec7b91c4ecabf239008cf573f175bc7019691b69d2483ba7e329d92d4daf86
TG_WEBHOOK_ADDR=:8085

# ===== YooKassa (карты) — ПОЗЖЕ. На старте оставь пустыми. =====
# Подключается без остановки сервиса: заполнить эти поля -> перезапустить только billing.
# <<< ВПИСАТЬ ПОЗЖЕ >>> shopId из кабинета YooKassa
YOOKASSA_SHOP_ID=
# <<< ВПИСАТЬ ПОЗЖЕ >>> секретный ключ из кабинета YooKassa
YOOKASSA_SECRET_KEY=
# Возврат пользователя после оплаты (на main):
YOOKASSA_RETURN_URL=https://main.race-src.com/payment-return
# <<< ВПИСАТЬ ПОЗЖЕ >>> openssl rand -hex 32 — попадёт в URL вебхука:
#   https://main.race-src.com/webhooks/yookassa/<этот токен>
YOOKASSA_WEBHOOK_TOKEN=
YOOKASSA_API_BASE=https://api.yookassa.ru/v3
YOOKASSA_ENFORCE_IP_CHECK=false
YOOKASSA_BIND_AMOUNT_RUB=1.00

# ===== Billing service (карты, цены в рублях) =====
PLAN_MONTHLY_PRICE_RUB=149.00
PLAN_QUARTERLY_PRICE_RUB=359.00
BILLING_HTTP_ADDR=:8082
BILLING_RENEWAL_TICK=1m
BILLING_RENEWAL_BATCH_SIZE=50
BILLING_GRACE_PERIOD=72h
BILLING_GRACE_EXPIRATION_TICK=1m
BILLING_GRACE_EXPIRATION_BATCH_SIZE=50
BILLING_REFUND_RETRY_TICK=1m
BILLING_RETRY_SCHEDULE=15m,6h,24h

# ===== User subscription service =====
USER_SUBSCRIPTION_HTTP_ADDR=:8083
# Базовый URL фида — на sub. Пользователь вставляет ссылку https://sub.race-src.com/sub/<токен>
SUBSCRIPTION_PUBLIC_BASE_URL=https://sub.race-src.com/sub/
SUBSCRIPTION_DEFAULT_COUNTRY=LT
# Длительность бесплатного триала в днях. Короткий триал снижает фарм через новые аккаунты.
TRIAL_DAYS=7

# ===== VPN orchestrator service =====
VPN_ORCHESTRATOR_HTTP_ADDR=:8084
SUBSCRIPTION_FEED_FORMAT=base64
SUBSCRIPTION_RATE_LIMIT_PER_MINUTE=30
ORCHESTRATOR_ADMIN_USER=admin
ORCHESTRATOR_ADMIN_PASS=f1de9621adf56a51eedc3d13c59b90a104625c804258fef0

# ===== Балансировка нагрузки (vpn-orchestrator) =====
# Нода считается живой, если её heartbeat не старше этого (агент шлёт каждые 30s).
NODE_HEARTBEAT_TTL=90s
# Лимит пользователей на ноду по умолчанию (always-on + видео-профиль -> 200).
NODE_DEFAULT_MAX_USERS=200
# Вес ноды по умолчанию (относительная мощность для распределения).
NODE_DEFAULT_WEIGHT=100
# Все ноды страны переполнены: true — выдать наименее загруженную (без отказа), false — исключить страну.
BALANCER_SOFT_OVERFLOW=true

# ===== Crypto billing service (CryptoBot / Crypto Pay API) =====
# Боевой API. Для теста: CRYPTOBOT_API_BASE=https://testnet-pay.crypt.bot/api
CRYPTOBOT_API_BASE=https://pay.crypt.bot/api
CRYPTOBOT_API_TOKEN=590980:AASJ5t50YD0PlultkTxgU9nfu0RXbGeGmdO
#   https://main.race-src.com/webhooks/cryptobot/<этот токен>
CRYPTOBOT_WEBHOOK_TOKEN=18b744ac33c814cb088e1e075c06d796fb4dd0c63fd2ac8c1534d0d34d0cc706
CRYPTOBOT_DEFAULT_ASSET=USDT
CRYPTOBOT_INVOICE_EXPIRES_IN=1800
# Метка кнопки после оплаты (официальные: viewItem/openChannel/openBot/callback).
CRYPTOBOT_PAID_BTN_NAME=callback
CRYPTOBOT_PAID_BTN_URL=
CRYPTO_BILLING_HTTP_ADDR=:8086

# Фиксированные цены в крипте (строки — чтобы не терять точность). Подстрой под свой курс.
CRYPTO_PLAN_MONTHLY_USDT=5.00
CRYPTO_PLAN_QUARTERLY_USDT=13.00
CRYPTO_PLAN_MONTHLY_TON=1.5
CRYPTO_PLAN_QUARTERLY_TON=4.0
CRYPTO_PLAN_MONTHLY_BTC=0.00008
CRYPTO_PLAN_QUARTERLY_BTC=0.00021
CRYPTO_PLAN_MONTHLY_ETH=0.0015
CRYPTO_PLAN_QUARTERLY_ETH=0.004

CRYPTO_STUCK_INVOICES_TICK=1m
CRYPTO_STUCK_INVOICES_THRESHOLD=2m

# ===== Поддержка (показывается пользователям в боте) =====
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=

# ===== Common =====
METRICS_ADDR=:9090
LOG_LEVEL=info
PG_MAX_CONNS=20
PG_MIN_CONNS=2
PG_MAX_CONN_LIFETIME=30m
PG_MAX_CONN_IDLE_TIME=10m
PG_HEALTHCHECK_PERIOD=30s
